# fail2ban jails for the Kitaphana droplet. Installed as /etc/fail2ban/jail.d/kitaphana.local.
# `fail2ban-client status` lists the jails; `fail2ban-client status <jail>` shows who is banned;
# `fail2ban-client set <jail> unbanip <address>` lets someone back in.

[DEFAULT]
# Ubuntu 24.04 logs sshd to the journal, not /var/log/auth.log.
backend = systemd
banaction = ufw

[sshd]
enabled  = true
maxretry = 5
findtime = 10m
bantime  = 1h

# Addresses that keep hitting nginx's per-address rate limit. Bans are short on purpose: one
# public address can be a whole mobile operator's worth of readers, so a ban must lift quickly.
[nginx-limit-req]
enabled  = true
backend  = auto
logpath  = /var/log/nginx/kitaphana.error.log
maxretry = 30
findtime = 1m
bantime  = 10m
