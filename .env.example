# Copy this file to .env and adjust as needed. Every setting has a safe default, so an
# application started with no .env file at all still starts — in its safest configuration.
# .env itself is git-ignored; never commit real secrets.

# Path to the SQLite database file.
# Default: kitaphana.db in the project root.
DATABASE_PATH=kitaphana.db

# Directory where uploaded book files and covers are stored.
# Default: media/ in the project root.
MEDIA_DIR=media

# Used to sign sessions and other tokens. Set a long random value in production;
# the default is fine for local development only.
SECRET_KEY=dev-insecure-secret-key-change-in-production

# When true, the login page shows the one-time code on screen instead of sending it by SMS.
# See ADR-0013. MUST be false (or unset) in production — the default is off, and any value
# other than a recognised "true" leaves it off.
DEV_OTP_MODE=true

# How long a one-time code stays valid, in seconds, and how many wrong tries burn it.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Code-request rate limits as comma-separated count/seconds pairs. A request is refused as soon
# as any one limit is reached. In Phase 2 every code is a paid SMS, so tighten rather than loosen.
# An unparseable value falls back to these defaults as a whole.
OTP_LIMITS_PER_PHONE=3/600,10/86400
OTP_LIMITS_PER_IP=10/600,50/86400

# How long a login lasts, in days. Long on purpose: every re-login will cost an SMS in Phase 2.
SESSION_TTL_DAYS=180

# Largest PDF an admin upload accepts, in MB. Keep nginx's client_max_body_size a little above
# this (Sprint 02), or nginx refuses big uploads before the app ever sees them.
MAX_UPLOAD_MB=200

# Mark the session cookie Secure (HTTPS only). Browsers treat http://localhost and
# http://127.0.0.1 as secure, so local development works with this on. Set to false only to
# test from another device on the LAN over plain HTTP. Default: on.
COOKIE_SECURE=true

# Downloads a reader may make, as count/seconds pairs (default: 10 an hour, 30 a day). Free books
# count too. An unparseable value falls back to these defaults as a whole.
DOWNLOAD_LIMITS=10/3600,30/86400

# true: the app answers a download with X-Accel-Redirect and nginx sends the file (ADR-0014).
# false: the app streams the file itself, for local development under a bare uvicorn, where
# there is no nginx and an X-Accel-Redirect response would arrive as an empty file.
# Default: true, which is what production needs.
DOWNLOADS_VIA_NGINX=false

# When true, the app runs with debug behaviour (e.g. more verbose error pages). Default: off.
DEBUG=true
